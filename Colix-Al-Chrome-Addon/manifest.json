{
    "manifest_version": 3,
    "name": "ColixLabs",
    "version": "1.2.0",
    "description": "Instantly expand text shortcuts while you type. Create custom abbreviations and boost your productivity.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "identity",
        "identity.email"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "utils/storage.js",
                "content/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "dashboard/paypal-checkout.html",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}