{
    "manifest_version": 3,
    "name": "Colix: Auto Text Expander & Autofill",
    "version": "1.2.2",
    "description": "Instantly expand text shortcuts while you type. Create custom abbreviations and boost your productivity.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "clipboardRead",
        "identity",
        "identity.email"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://*.supabase.co/*",
        "https://www.googleapis.com/*"
    ],
    "oauth2": {
        "client_id": "683094072539-otivcoos0kq99i7ied5apci08behrcim.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/userinfo.profile",
            "https://www.googleapis.com/auth/userinfo.email"
        ]
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "https://accounts.google.com/*",
                "https://*.google.com/*",
                "https://*.supabase.co/*"
            ],
            "js": [
                "utils/supabase-config.js",
                "utils/supabase-client.js",
                "utils/auth-manager.js",
                "utils/sync-manager.js",
                "utils/storage.js",
                "content/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "dashboard/*.html",
                "dashboard/header/*.html",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
