{
    "manifest_version": 3,
    "name": "Colix: Auto Text Expander & Autofill",
    "version": "1.2.6",
    "description": "Instantly expand text shortcuts while you type. Create custom abbreviations and boost your productivity.",
    "permissions": [
        "storage",
        "clipboardRead",
        "identity",
        "identity.email"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://localhost/*",
        "https://extensions.kbizsoft.com/*",
        "https://*.supabase.co/*",
        "https://mail.google.com/*",
        "https://colixai.com/*"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "https://accounts.google.com/*",
                "https://*.supabase.co/*"
            ],
            "js": [
                "utils/supabase-config.js",
                "utils/supabase-client.js",
                "utils/auth-manager.js",
                "utils/sync-manager.js",
                "utils/storage.js",
                "content/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        },
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "utils/supabase-config.js",
                "utils/supabase-client.js",
                "utils/auth-manager.js",
                "utils/sync-manager.js",
                "utils/storage.js",
                "content/content.js",
                "gmail/gmail-ai.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "dashboard/header/*.html",
                "dashboard/teams_plans.html",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
