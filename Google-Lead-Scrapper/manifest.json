{
    "manifest_version": 3,
    "name": "Google Maps Leads Scrapper",
    "short_name": "lead_scrapper",
    "description": "Scrap the leads based on the Google Locations",
    "version": "1.0",
    "action": {
        "default_icon": "assets/icons/icon-128.png",
        "default_title": "Scrap the leads based on the Google Locations",
        "default_popup": "popup.html"
    },
    "icons": {
        "128": "assets/icons/icon-128.png"
    },
    "host_permissions": [
        "http://www.google.com/maps/*",
        "https://www.google.com/maps/*"
    ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/maps/*"
            ],
            "js": [
                "content-scripts/content.js",
                "page-popup.js"
            ],
            "run_at": "document_end"
        }
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "background",
        "identity"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/images/*",
                "assets/icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}